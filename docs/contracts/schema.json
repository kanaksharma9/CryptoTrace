{
  "Alert": {
    "$defs": {
      "Chain": {
        "enum": [
          "eth",
          "bsc",
          "polygon"
        ],
        "title": "Chain",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "address": {
        "title": "Address",
        "type": "string"
      },
      "alert_id": {
        "format": "uuid",
        "title": "Alert Id",
        "type": "string"
      },
      "amount": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Amount"
      },
      "case_id": {
        "format": "uuid",
        "title": "Case Id",
        "type": "string"
      },
      "chain": {
        "$ref": "#/$defs/Chain"
      },
      "kind": {
        "enum": [
          "new_outflow",
          "reached_vasp",
          "bridge_used",
          "mixer_used"
        ],
        "title": "Kind",
        "type": "string"
      },
      "message": {
        "title": "Message",
        "type": "string"
      },
      "ts": {
        "format": "date-time",
        "title": "Ts",
        "type": "string"
      },
      "tx_hash": {
        "title": "Tx Hash",
        "type": "string"
      }
    },
    "required": [
      "alert_id",
      "case_id",
      "chain",
      "address",
      "kind",
      "tx_hash",
      "message",
      "ts"
    ],
    "title": "Alert",
    "type": "object"
  },
