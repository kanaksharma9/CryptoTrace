CT_ENV=dev
CT_PROVIDER=fixture # fixture | alchemy | etherscan (start with fixture!)
ALCHEMY_API_KEY= # free key: alchemy.com -> create app per chain you need
ETHERSCAN_API_KEY= # free key (Etherscan v2 multichain; verify free coverage per chain on Day 1)
DATABASE_URL=postgresql+asyncpg://ct:ct@localhost:5432/cryptotrace
DATABASE_URL_SYNC=postgresql+psycopg2://ct:ct@localhost:5432/cryptotrace
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ct-neo4j-pass
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=ctminio
MINIO_SECRET_KEY=ctminio-secret
MINIO_BUCKET=evidence
JWT_SECRET=dev-only-change-me
SAHYOG_HMAC_SECRET=dev-hmac
MLFLOW_TRACKING_URI=http://localhost:5000
BACKEND_URL=http://localhost:8000 # used by Next.js rewrites
